rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin rights: a document at admins/{uid} created by the owner in the Firebase console
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function existing() {
      return resource.data;
    }
    
    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidArtwork(data) {
      return data.keys().hasAll(['title', 'description', 'category', 'imageUrl', 'artist']) &&
             data.title is string && data.title.size() <= 300 &&
             data.description is string && data.description.size() <= 20000 &&
             data.category is string && data.category.size() <= 100 &&
             data.imageUrl is string && data.imageUrl.size() <= 2000000 &&
             data.artist is string && data.artist.size() <= 200;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['labelEn', 'labelFa']) &&
             data.labelEn is string && data.labelEn.size() <= 100 &&
             data.labelFa is string && data.labelFa.size() <= 100;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'status', 'createdAt']) &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.message is string && data.message.size() <= 5000 &&
             data.status is string && data.status.size() <= 50 &&
             data.createdAt is string &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 30)) &&
             (!('messages' in data) || (data.messages is list && data.messages.size() <= 200)) &&
             (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 5000)) &&
             (!('replySubject' in data) || (data.replySubject is string && data.replySubject.size() <= 500)) &&
             (!('replyMessage' in data) || (data.replyMessage is string && data.replyMessage.size() <= 5000));
    }

    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Published content: everyone can read, only admins can change
    match /artworks/{artworkId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(artworkId) && isValidArtwork(incoming());
      allow delete: if isAdmin() && isValidId(artworkId);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /config/{configId} {
      allow get: if configId == 'main_site_config' || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && configId == 'main_site_config';
      allow delete: if isAdmin() && configId != 'main_site_config';
    }

    // Visitors may submit a new inquiry; only admins can read, edit or delete them
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming()) && incoming().status == 'new';
      allow read: if isAdmin();
      allow update: if isAdmin() && isValidInquiry(incoming());
      allow delete: if isAdmin();
    }
  }
}
