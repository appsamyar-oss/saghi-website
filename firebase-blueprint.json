{
  "entities": {
    "Artwork": {
      "title": "Artwork",
      "description": "Represents an artwork in the gallery",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "artist": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "description", "category", "imageUrl", "artist", "createdAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Artwork category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "labelEn": { "type": "string" },
        "labelFa": { "type": "string" }
      },
      "required": ["labelEn", "labelFa"]
    },
    "Config": {
      "title": "Site Config",
      "description": "Global website configuration",
      "type": "object",
      "properties": {
        "atelierNameEn": { "type": "string" },
        "atelierNameFa": { "type": "string" }
      }
    },
    "AdminAuth": {
      "title": "Admin Authentication Credentials",
      "description": "Custom atelier administrative authentication credentials",
      "type": "object",
      "properties": {
        "username": { "type": "string", "maxLength": 100 },
        "password": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 150 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["username", "password"]
    },
    "Inquiry": {
      "title": "Commission Inquiry",
      "description": "User inquiries and bidirectional email conversation threads",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 50 },
        "inquiryType": { "type": "string", "maxLength": 50 },
        "artworkId": { "type": "string", "maxLength": 100 },
        "artworkTitle": { "type": "string", "maxLength": 200 },
        "interest": { "type": "string", "maxLength": 300 },
        "dimensions": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 5000 },
        "status": { "type": "string", "maxLength": 50 },
        "tags": { "type": "array" },
        "messages": { "type": "array" },
        "adminNotes": { "type": "string", "maxLength": 2000 },
        "repliedAt": { "type": "string" },
        "replySubject": { "type": "string", "maxLength": 300 },
        "replyMessage": { "type": "string", "maxLength": 5000 },
        "emailDeliveryStatus": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "message", "status", "createdAt"]
    }
  },
  "firestore": {
    "/artworks/{artworkId}": {
      "schema": { "$ref": "#/entities/Artwork" },
      "description": "Gallery artworks"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Gallery categories"
    },
    "/config/{configId}": {
      "schema": { "$ref": "#/entities/Config" },
      "description": "Global config and admin credentials"
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "User inquiries"
    }
  }
}
