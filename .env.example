# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: API Key from https://resend.com for automated customer confirmations & admin email notifications
RESEND_API_KEY=

# ADMIN_NOTIFICATION_EMAIL: Destination email for receiving new inquiry alerts (default: appsamyar@gmail.com)
ADMIN_NOTIFICATION_EMAIL="appsamyar@gmail.com"

# SENDER_EMAIL: Verified sender address in Resend (Saghi Abyar official studio email)
SENDER_EMAIL="Saghi Abyar Studio <contact@saghiabyar.com>"

# ADMIN_UIDS: Comma-separated Firebase Auth user IDs allowed to use admin API endpoints
# (send replies, test emails, read the inbox). Must match the documents in the Firestore "admins" collection.
ADMIN_UIDS=

# RESEND_WEBHOOK_SECRET: Signing secret of the Resend inbound webhook (whsec_...). Required in production.
RESEND_WEBHOOK_SECRET=
